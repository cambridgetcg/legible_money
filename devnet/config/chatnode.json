{
  "$schema": "../schemas/node-config.json",
  "description": "Lightweight local node configuration for API chat sessions",

  "node": {
    "mode": "light",
    "syncMode": "headers-and-knowledge",
    "role": "fullnode",
    "name": "chatnode-local"
  },

  "network": {
    "listenAddresses": [
      "/ip4/127.0.0.1/tcp/0"
    ],
    "bootstrap": [
      "/dns4/bootstrap1.legiblemoney.io/tcp/9000/p2p/12D3KooWBootstrap1",
      "/dns4/bootstrap2.legiblemoney.io/tcp/9000/p2p/12D3KooWBootstrap2"
    ],
    "maxPeers": 8,
    "minPeers": 2,
    "enableMdns": true,
    "enableDht": true,
    "dhtMode": "client"
  },

  "rpc": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 8545,
    "cors": ["http://localhost:*"],
    "maxConnections": 10,
    "timeout": 30000,
    "methods": {
      "enabled": [
        "knowledge_getFacts",
        "knowledge_getFact",
        "knowledge_submitClaim",
        "knowledge_sessionStart",
        "knowledge_sessionEnd",
        "knowledge_query",
        "knowledge_estimateQueryCost",
        "agent_checkAccount",
        "agent_getStatus",
        "account_getBalance",
        "account_getInfo",
        "network_health",
        "state_getBlock",
        "state_getBlockNumber"
      ],
      "disabled": [
        "verification_*",
        "admin_*"
      ]
    },
    "rateLimit": {
      "enabled": true,
      "maxRequestsPerSecond": 100,
      "maxRequestsPerMinute": 1000
    }
  },

  "consensus": {
    "enabled": false,
    "validatorEnabled": false,
    "blockTime": 2521
  },

  "storage": {
    "path": "~/.lgm/chatnode",
    "engine": "leveldb",
    "pruneBlocks": true,
    "keepBlocks": 1000,
    "indexKnowledge": true,
    "indexAccounts": false,
    "cacheSize": 128
  },

  "sync": {
    "lightSync": true,
    "syncHeaders": true,
    "syncKnowledgeTree": true,
    "syncAccountTree": false,
    "syncValidatorTree": false,
    "syncFullState": false,
    "snapshotInterval": 100,
    "snapshotUrl": "https://snapshots.legiblemoney.io/knowledge/latest.tar.gz",
    "maxBlocksBehind": 100,
    "syncBatchSize": 50
  },

  "knowledge": {
    "reasoningIndex": {
      "enabled": true,
      "confidenceBuckets": 100,
      "maxDependencyDepth": 10,
      "gatewayThreshold": 0.3
    },
    "sessionCache": {
      "enabled": true,
      "factCacheSize": 500,
      "domainCacheSize": 100,
      "sessionTimeoutMs": 3600000
    },
    "prefetch": {
      "enabled": true,
      "concurrency": 3,
      "prefetchCount": 5
    }
  },

  "logging": {
    "level": "info",
    "format": "json",
    "output": "stdout",
    "modules": {
      "rpc": "info",
      "sync": "warn",
      "network": "warn",
      "knowledge": "debug"
    }
  },

  "metrics": {
    "enabled": true,
    "port": 9090,
    "endpoint": "/metrics"
  },

  "health": {
    "enabled": true,
    "port": 8080,
    "endpoint": "/health"
  }
}
