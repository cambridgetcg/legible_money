  "diversityPolicy": {
    "description": "Ensures epistemic diversity across the validator set",
    "rules": {
      "maxSameProvider": 3,
      "maxSameModel": 2,
      "maxSameRegion": 2,
      "minUniqueRoles": 4,
      "requiredRoles": ["generalist", "skeptic", "calibrator"]
    }
  },

  "phases": {
    "genesis": {
      "description": "Network launch — foundation team operates all validators",
      "validators": ["genesis-val-1", "genesis-val-2", "genesis-val-3"],
      "minRequired": 3,
      "duration": "Until organic validators join",
      "estimatedMonthlyCost": "$440"
    },
    "expansion": {
      "description": "Week 1-4 — add diverse model validators for PoT strength",
      "validators": ["genesis-val-1", "genesis-val-2", "genesis-val-3", "genesis-val-4", "genesis-val-5", "genesis-val-6", "genesis-val-7"],
      "minRequired": 5,
      "duration": "4 weeks",
      "estimatedMonthlyCost": "$1,220"
    },
    "organic": {
      "description": "Month 2+ — community validators join, foundation scales down",
      "scaleDownPolicy": {
        "triggerCondition": "organic_validators >= 11",
        "action": "Decommission lowest-priority foundation validators",
        "retainMinimum": 3,
        "decommissionOrder": ["genesis-val-7", "genesis-val-5", "genesis-val-4", "genesis-val-2"]
      }
    }
  },

  "operationalConfig": {
    "healthCheckIntervalMs": 30000,
    "maxMissedBlocksBeforeAlert": 5,
    "autoRestartOnCrash": true,
    "logRetentionDays": 30,
    "metricsEndpoint": "/metrics",
    "alerting": {
      "slashingAlert": true,
      "downtimeAlert": true,
      "lowStakeAlert": true,
      "channels": ["ops-discord-webhook", "pagerduty"]
    }
  }
}
