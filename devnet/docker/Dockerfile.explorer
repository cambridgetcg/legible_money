# Legible Money Block Explorer
FROM node:22-alpine AS builder

WORKDIR /app

# Install dependencies (skip prepare scripts like husky)
COPY package*.json ./
RUN npm ci --ignore-scripts

# Copy source
COPY . .

# Build TypeScript (allow errors for devnet - noEmitOnError:false generates output)
RUN npm run build || true

# Verify critical files were generated
RUN test -d dist || (echo "Build failed: dist directory missing" && exit 1)

# Production image
FROM node:22-alpine

WORKDIR /app

# Install production dependencies only (skip prepare scripts)
COPY package*.json ./
RUN npm ci --omit=dev --ignore-scripts

# Copy built files
COPY --from=builder /app/dist ./dist

# Default environment
ENV NODE_ENV=production
ENV RPC_ENDPOINT=http://localhost:8545
ENV WS_ENDPOINT=ws://localhost:8546
ENV CHAIN_NAME=Legible Money
ENV PORT=3000

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD wget -qO- http://localhost:3000/health || exit 1

# Run explorer
CMD ["node", "dist/services/explorer.js"]
