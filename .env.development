# Development Environment - Optimized for Apple M4 Max
#
# Hardware Profile:
#   CPU: Apple M4 Max (14 cores: 10 performance + 4 efficiency)
#   GPU: 32 cores (Metal 3)
#   RAM: 36GB unified memory
#
# These settings maximize parallel processing and memory usage.

# === Node.js Configuration ===
# Allocate 27GB to Node.js (75% of available)
NODE_OPTIONS="--max-old-space-size=27648 --experimental-vm-modules"

# === Parallelism Settings ===
# Use all performance cores for CPU-bound tasks
UV_THREADPOOL_SIZE=10
GOMAXPROCS=14

# === TypeScript Configuration ===
# Enable parallel type checking
TS_NODE_TRANSPILE_ONLY=false
TSC_COMPILE_ON_ERROR=false

# === Testing Configuration ===
# Vitest parallel workers
VITEST_MAX_THREADS=10
VITEST_MIN_THREADS=10

# === Build Configuration ===
# esbuild/tsup parallel processing
ESBUILD_MAX_THREADS=10

# === Network Configuration (for devnet) ===
# Run multiple nodes in parallel
DEVNET_NODE_COUNT=10
DEVNET_PARALLEL_START=true

# === Memory Settings ===
# Disable memory limits for development
MALLOC_ARENA_MAX=4

# === Logging ===
LOG_LEVEL=info
DEBUG=legible:*
