#!/usr/bin/env sh
#
# Auto-push after every successful commit.
# Fails silently if offline or remote is unreachable.
# Set HUSKY_NO_PUSH=1 to skip (e.g., during rebase).
#

[ "${HUSKY_NO_PUSH:-}" = "1" ] && exit 0

branch=$(git branch --show-current 2>/dev/null)

# Only push if we're on a branch (not detached HEAD)
[ -z "$branch" ] && exit 0

# Push to the tracked remote, quietly
git push origin "$branch" --quiet 2>/dev/null &

# Don't block the terminal — fire and forget
exit 0
