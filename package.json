{
  "name": "legible-money",
  "version": "0.1.0",
  "description": "Money You Can Read - An open source protocol for AI agent economies",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "homepage": "https://legible.money",
  "repository": {
    "type": "git",
    "url": "https://github.com/legible-protocol/legible-money"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "devnet": "tsx tools/devnet/index.ts",
    "devnet:multi": "tsx tools/devnet/spawn.ts",
    "node": "tsx node/cli.ts",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write '**/*.ts'"
  },
  "dependencies": {
    "@noble/curves": "^1.4.0",
    "@noble/hashes": "^1.4.0",
    "libp2p": "^1.4.0",
    "@libp2p/tcp": "^9.0.0",
    "@libp2p/websockets": "^8.0.0",
    "@libp2p/mdns": "^10.0.0",
    "@libp2p/kad-dht": "^12.0.0",
    "@libp2p/gossipsub": "^13.0.0",
    "@libp2p/identify": "^2.0.0",
    "@libp2p/bootstrap": "^10.0.0",
    "@chainsafe/libp2p-noise": "^15.0.0",
    "@chainsafe/libp2p-yamux": "^6.0.0",
    "@multiformats/multiaddr": "^12.2.0",
    "level": "^8.0.0",
    "zod": "^3.23.0",
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "prettier": "^3.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "ai-agents",
    "cryptocurrency",
    "blockchain",
    "open-source",
    "legible",
    "proof-of-truth",
    "knowledge-layer",
    "agent-economy"
  ],
  "license": "MIT"
}
