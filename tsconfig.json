{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "ES2018.AsyncIterable"],
    "types": ["node"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noEmitOnError": false,

    // === M4 Max Optimizations ===
    // Incremental compilation (massive speedup for rebuilds)
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",

    // Faster type checking
    "assumeChangesOnlyAffectDirectDependencies": true
  },
  "include": [
    "cmd/**/*.ts",
    "foundation/**/*.ts",
    "infrastructure/**/*.ts",
    "core/**/*.ts",
    "protocol/**/*.ts",
    "agents/**/*.ts",
    "markets/**/*.ts",
    "coordination/**/*.ts",
    "sdk/**/*.ts",
    "consensus/**/*.ts",
    "state/**/*.ts",
    "network/**/*.ts",
    "storage/**/*.ts",
    "messaging/**/*.ts",
    "endpoints/**/*.ts",
    "schedule/**/*.ts",
    "devnet/**/*.ts",
    "tools/**/*.ts",
    "tokens/**/*.ts",
    "contracts/**/*.ts",
    "vm/**/*.ts",
    "home/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests"
  ]
}
